APP_NAME=Jobic
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Installation
INSTALLATION=
INSTALLATION_LOCALE=en
INSTALLATION_STATUS=pending
INSTALLATION_STEP=0
INSTALLATION_TASK=0

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS="14"

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jobic
DB_USERNAME=root
DB_PASSWORD=
DB_URL="null"

# Session
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production (EU): SESSION_SECURE_COOKIE=true, SESSION_ENCRYPT=true, SESSION_SAME_SITE=lax
SESSION_EXPIRE_ON_CLOSE="0"
SESSION_SECURE_COOKIE="0"
SESSION_SAME_SITE="lax"
SESSION_CONNECTION="null"
SESSION_STORE="null"
SESSION_TABLE="sessions"

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MEMCACHED_HOST=127.0.0.1

# Redis
REDIS_CLIENT=phpredis
REDIS_SCHEME=tcp
REDIS_USERNAME=null
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_URL="null"

# Mail
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_URL="null"

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

AUTH_REMEMBER_DAYS=30

# Kanban live updates (run php artisan reverb:start alongside the application)
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
# Public browser endpoint may differ from the internal broadcaster endpoint.
REVERB_PUBLIC_HOST=127.0.0.1
REVERB_PUBLIC_PORT=8080
REVERB_PUBLIC_SCHEME=http
REVERB_ALLOWED_ORIGINS=localhost
# Optional direct TLS for local HTTPS development; production normally terminates at its proxy.
REVERB_TLS_CERT=
REVERB_TLS_KEY=
REVERB_CA_FILE=true
