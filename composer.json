{
    "name": "jobmetric/jobic",
    "type": "project",
    "description": "Jobic's House! Content Management System",
    "keywords": [
        "jobic",
        "jobmetric",
        "CMS"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-dom": "*",
        "ext-libxml": "*",
        "ext-pdo": "*",
        "ext-redis": "*",
        "ext-zip": "*",
        "bacon/bacon-qr-code": "^3.0",
        "jobmetric/domi": "^1.14.2",
        "jobmetric/laravel-comment": "^1.2.0",
        "jobmetric/laravel-custom-field": "^2.3.1",
        "jobmetric/laravel-env-modifier": "^2.2",
        "jobmetric/laravel-event-system": "^2.10.3",
        "jobmetric/laravel-extension": "^2.3.2",
        "jobmetric/laravel-flow": "^2.5.0",
        "jobmetric/laravel-language": "^2.6.0",
        "jobmetric/laravel-layout": "^2.1.0",
        "jobmetric/laravel-like": "^1.6.0",
        "jobmetric/laravel-membership": "^1.4.0",
        "jobmetric/laravel-metadata": "^4.1.0",
        "jobmetric/laravel-package-core": "^1.39.0",
        "jobmetric/laravel-post": "^1.4.0",
        "jobmetric/laravel-setting": "^2.2.0",
        "jobmetric/laravel-star": "^1.2.0",
        "jobmetric/laravel-taxonomy": "^4.4.0",
        "jobmetric/laravel-translation": "^4.1.0",
        "jobmetric/laravel-url": "^3.1.0",
        "jobmetric/media": "^2.3.0",
        "jobmetric/rolix": "^1.4.0",
        "laravel/framework": "^13.17",
        "laravel/reverb": "^1.13",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^3.0",
        "lorisleiva/laravel-actions": "^2.9",
        "pragmarx/google2fa": "^9.0",
        "spatie/laravel-query-builder": "^6.3|^7.0",
        "tymon/jwt-auth": "^2.2"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.5",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
